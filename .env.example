# VayuSetu environment variables. Copy to .env.local for development; on
# Firebase App Hosting, set these in apphosting.yaml / Secret Manager.
# Every integration degrades to an explicit "not configured" state when its
# variables are missing — nothing falls back to made-up data.

# ── Firebase (client) ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional App Check (reCAPTCHA Enterprise site key). Pair with APP_CHECK_ENFORCE.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# ── Firebase Admin (server) ──────────────────────────────────────────────────
# On App Hosting the runtime service account is used automatically. Locally,
# a service-account JSON (raw or base64):
FIREBASE_SERVICE_ACCOUNT_KEY=
# Require App Check tokens on /api/reports ("true" to enforce).
APP_CHECK_ENFORCE=false

# ── Operators ────────────────────────────────────────────────────────────────
# Comma-separated Firebase Auth emails allowed to dispatch/resolve, draft work
# orders and use the copilot. (Alternatively set the custom claim operator=true.)
OPERATOR_EMAILS=

# ── Maps (browser key, HTTP-referrer restricted) ────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Server-side Google APIs (separate, server-restricted keys) ──────────────
GEMINI_API_KEY=
GOOGLE_AIR_QUALITY_API_KEY=
# Places API (New) + Geocoding: report location search and nearby schools/hospitals.
GOOGLE_PLACES_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ── Earth Engine (Sentinel-5P NO2/aerosol + NASA FIRMS fires) ───────────────
# Authenticates with FIREBASE_SERVICE_ACCOUNT_KEY (the same account runs
# Firebase Admin, Earth Engine and BigQuery). Set a separate key only to
# use a different account.
EARTH_ENGINE_PROJECT_ID=
EARTH_ENGINE_SERVICE_ACCOUNT_KEY=

# ── BigQuery (live station history, archive, BigQuery ML ARIMA_PLUS) ────────
BIGQUERY_PROJECT_ID=
# Optional overrides; defaults live in dataset "cleanair_analytics".
BIGQUERY_DATASET=
BIGQUERY_LIVE_TABLE=
BIGQUERY_FORECAST_TABLE=
BIGQUERY_ARIMA_MODEL=
# Only if not using Application Default Credentials:
BIGQUERY_CLIENT_EMAIL=
BIGQUERY_PRIVATE_KEY=

# ── Other data sources ──────────────────────────────────────────────────────
# data.gov.in key for the CPCB real-time feed (the public sample key is no
# longer authorised, so this is required for sensor data).
CPCB_API_KEY=
# World Air Quality Index token: ground stations for every capital except
# Delhi (Beijing, Moscow, Pretoria, Abu Dhabi, Jakarta, Brasilia).
# Free for non-commercial use: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=
IMGBB_API_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────
# Bearer secret Cloud Scheduler sends to /api/cron/tick (and to force
# /api/scan-ambient?force=1).
CRON_SECRET=

# ── WhatsApp status updates to reporters (Twilio) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Shared with whatsapp_bot: lets reporters answer "is it fixed?" by replying
# FIXED or STILL (POST /api/closure/whatsapp). Any long random string.
WHATSAPP_CLOSURE_SECRET=

# ── Tooling only ─────────────────────────────────────────────────────────────
# Enables POST /api/translate (disabled when unset).
TRANSLATE_API_SECRET=
